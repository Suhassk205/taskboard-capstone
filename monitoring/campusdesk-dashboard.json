{
  "title": "CampusDesk \u2014 application health",
  "uid": "campusdesk",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests handled",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(http_requests_total{job=\"campusdesk\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(handler) (rate(http_requests_total{job=\"campusdesk\"}[1m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
